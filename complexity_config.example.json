{
	"include": [
		"res://**/*.gd"
	],
	"exclude": [
		"res://.git/**",
		"res://.godot/**",
		"res://node_modules/**",
		"res://addons/gdscript_complexity/**",
		"res://addons/**/test/**",
		"res://tests/**",
		"res://cli/**",
		"res://examples/**"
	],
	"cc": {
		"threshold_warn": 10,
		"threshold_fail": 20
	},
	"cog": {
		"threshold_warn": 15,
		"threshold_fail": 30
	},
	"structural": {
		"nesting_warn": 3,
		"nesting_fail": 5,
		"params_warn": 4,
		"params_fail": 8,
		"loc_warn": 300,
		"loc_fail": 500
	},
	"parser": {
		"parser_mode": "balanced",
		"confidence_weights": {
			"token_coverage": 0.0,
			"indentation_consistency": 0.0,
			"block_balance": 0.0,
			"parse_errors": 1.0
		}
	},
	"report": {
		"formats": ["json", "csv", "html"],
		"output_path": "res://complexity_report.json",
		"csv_output_path": "res://complexity_report.csv",
		"html_output_path": "res://complexity_report.html",
		"history_path": "complexity_history.jsonl",
		"auto_export": false,
		"annotate_editor": false,
		"churn_hotspots": "auto",
		"churn_since": "90 days ago",
		"god_complex_func_min": 3
	},
	"performance": {
		"enable_caching": true,
		"cache_path": ".gdcomplexity_cache",
		"incremental_analysis": true,
		"enable_profiling": false
	},
	"telemetry": {
		"enable_anonymous_reporting": false
	},
	"logging": {
		"enable_console": true,
		"enable_file": false,
		"file_path": "res://complexity_analyzer.log",
		"level": "info"
	}
}